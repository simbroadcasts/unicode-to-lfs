{
  "name": "unicode-to-lfs",
  "version": "2.0.1",
  "description": "Convert Unicode messages to LFS",
  "keywords": [
    "lfs",
    "live for speed",
    "unicode",
    "utf-8",
    "string",
    "encoding"
  ],
  "repository": "git@github.com:simbroadcasts/unicode-to-lfs.git",
  "author": "Martin Kapal <flamecze@gmail.com>",
  "license": "MIT",
  "source": "src/index.ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "files": [
    "dist",
    "!dist/codepageTables.d.ts"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "run-s build:*",
    "build:js": "esbuild src/index.ts --bundle --format=cjs --outdir=dist --minify",
    "build:ts": "tsc --emitDeclarationOnly",
    "dev": "tsx watch src/index.ts",
    "format": "run-s \"format:no-write --write\"",
    "format:no-write": "prettier \"./**/*.{js,ts,md,json}\"",
    "format:check": "run-s \"format:no-write --check\"",
    "test": "jest",
    "example": "node example/index.js",
    "bump": "node scripts/bump.mjs",
    "prepack": "run-s build"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "chalk": "^6.0.0",
    "esbuild": "^0.28.2",
    "esbuild-node-externals": "^2.0.0",
    "jest": "^30.5.1",
    "jest-junit": "^17.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "semver": "^7.8.5",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
