{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["jest"],
    "strict": true,
    "declaration": true,
    "stripInternal": true,
    "target": "ESNext",
    "module": "CommonJS",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noImplicitAny": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
